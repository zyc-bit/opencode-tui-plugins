{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
