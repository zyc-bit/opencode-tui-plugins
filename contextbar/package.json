{
  "name": "opencode-contextbar",
  "version": "0.1.0",
  "description": "OpenCode plugin: context usage bar above the input, partitioned into system prompt / tools / memory / skills / messages with free space and autocompact buffer",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyc-bit/opencode-tui-plugins.git",
    "directory": "contextbar"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "context",
    "tokens"
  ],
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx",
    "./rpc": "./rpc.ts"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "core.ts",
    "rpc.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": ">=2.1.3 <3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  }
}
